# RYNA 0.1.0 Environment Configuration
# Copy this file to .env and configure only what you need.
# Never commit .env or real API keys to version control.

# Local engine bind settings (keep 127.0.0.1 for local-only security)
RYNA_HOST=127.0.0.1
RYNA_PORT=8765
RYNA_LOG_LEVEL=INFO
RYNA_DATA_DIR=data
RYNA_DB_PATH=data/ryna.db

# Offline / Local AI (Ollama)
RYNA_OLLAMA_BASE_URL=http://127.0.0.1:11434
RYNA_LOCAL_MODEL=

# Cloud AI Providers (optional — leave blank for offline-only operation)
RYNA_ALLOW_CLOUD=false
RYNA_OPENAI_API_KEY=
RYNA_OPENAI_BASE_URL=https://api.openai.com/v1
RYNA_OPENAI_MODEL=gpt-4o-mini

RYNA_ANTHROPIC_API_KEY=
RYNA_ANTHROPIC_MODEL=claude-3-5-sonnet-latest

RYNA_GEMINI_API_KEY=
RYNA_GEMINI_MODEL=gemini-2.0-flash

# Preferred provider order: auto | ollama | openai | anthropic | gemini
RYNA_PREFERRED_PROVIDER=auto
