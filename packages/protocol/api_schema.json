{
  "name": "RYNA Local Engine API",
  "version": "0.1.0",
  "transport": "HTTP JSON over loopback (127.0.0.1:8765)",
  "endpoints": [
    {"method": "GET", "path": "/api/v1/health", "description": "Lightweight liveness check"},
    {"method": "GET", "path": "/api/v1/status", "description": "Full engine status, hardware profile, connectivity, AI providers, voice, and DB stats"},
    {"method": "GET", "path": "/api/v1/settings", "description": "Retrieve all persisted settings"},
    {"method": "PUT", "path": "/api/v1/settings", "description": "Persist partial or full settings updates"},
    {"method": "GET", "path": "/api/v1/conversations", "description": "List stored local conversations"},
    {"method": "POST", "path": "/api/v1/conversations", "description": "Create a new conversation"},
    {"method": "DELETE", "path": "/api/v1/conversations/{id}", "description": "Delete a conversation and its messages"},
    {"method": "GET", "path": "/api/v1/conversations/{id}/messages", "description": "Fetch message history for a conversation"},
    {"method": "POST", "path": "/api/v1/chat", "description": "Send message through AI router or explicit local slash-tool"},
    {"method": "GET", "path": "/api/v1/memories", "description": "List or search memories (?category=&q=)"},
    {"method": "POST", "path": "/api/v1/memories", "description": "Store a categorized memory (with secret guard & dedup)"},
    {"method": "PATCH", "path": "/api/v1/memories/{id}", "description": "Edit an existing memory"},
    {"method": "DELETE", "path": "/api/v1/memories/{id}", "description": "Delete a single memory"},
    {"method": "DELETE", "path": "/api/v1/memories", "description": "Clear all memories or a single category (?category=)"},
    {"method": "GET", "path": "/api/v1/memories/export", "description": "Export all memories as JSON"},
    {"method": "GET", "path": "/api/v1/tasks", "description": "List persistent tasks (?status=)"},
    {"method": "POST", "path": "/api/v1/tasks", "description": "Create a persistent task (optional auto_run)"},
    {"method": "GET", "path": "/api/v1/tasks/{id}", "description": "Get task and step states"},
    {"method": "POST", "path": "/api/v1/tasks/{id}/run", "description": "Run or approve/resume a task"},
    {"method": "POST", "path": "/api/v1/tasks/{id}/pause", "description": "Pause a task"},
    {"method": "POST", "path": "/api/v1/tasks/{id}/cancel", "description": "Cancel a task"},
    {"method": "GET", "path": "/api/v1/notes", "description": "List local notes and reminders"},
    {"method": "POST", "path": "/api/v1/notes", "description": "Create a local note or reminder"},
    {"method": "GET", "path": "/api/v1/audit", "description": "List permission and action audit log"},
    {"method": "GET", "path": "/api/v1/tools", "description": "List registered local tools"},
    {"method": "GET", "path": "/api/v1/ai/providers", "description": "Live AI provider configuration and reachability"},
    {"method": "GET", "path": "/api/v1/voice/status", "description": "Voice pipeline mode, state, and detected offline backends"},
    {"method": "POST", "path": "/api/v1/voice/state", "description": "Update companion/voice visual state"},
    {"method": "POST", "path": "/api/v1/voice/interrupt", "description": "Barge-in / immediately cancel active speech or generation"},
    {"method": "POST", "path": "/api/v1/emergency-stop", "description": "Immediately halt active tasks and block mutating actions"},
    {"method": "POST", "path": "/api/v1/emergency-stop/reset", "description": "Reset emergency stop state"}
  ]
}
